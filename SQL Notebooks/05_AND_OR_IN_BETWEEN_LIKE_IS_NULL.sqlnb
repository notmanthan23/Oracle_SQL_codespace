cells:
  - kind: 2
    value: expression_1 AND expression_2
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
           order_id,
           customer_id,
           status,
           order_date
      FROM
           orders
      WHERE
           status = 'Pending'
           AND customer_id = 2
      ORDER BY
           order_date;
    languageId: oracle-sql
  - kind: 2
    value: status = ' Pending '
    languageId: oracle-sql
  - kind: 2
    value: customer_ld = 2
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
           order_id,
           customer_id,
           status,
           order_date
      FROM
          orders
      WHERE
            status = 'Shipped'
            AND salesman_id = 60
            AND EXTRACT(YEAR FROM order_date) = 2017
      ORDER BY
             order_date;
    languageId: oracle-sql
  - kind: 1
    value: "#  Oracle AND to combine more than two Boolean expressions"
    languageId: markdown
  - kind: 2
    value: |
      SELECT
          order_id,
          customer_id,
          status,
          order_date
      FROM
         orders
      WHERE
         status = 'Pending'
         OR status = 'Canceled '
      ORDER BY
      order_date DESC;
    languageId: oracle-sql
  - kind: 1
    value: "#   Using Oracle OR operator to combine two Boolean expressions example"
    languageId: markdown
  - kind: 2
    value: |
      status 'pending'
      status = 'Canceled'
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
          order_id,
          customer_id,
      status,
         salesman_id,
         order_date
      FROM
           orders
      WHERE
           salesman_id IN (60, 61, 62)
      ORDER BY
            order_date DESC;
    languageId: oracle-sql
  - kind: 1
    value: "#   Oracle OR operator to combine more than two Boolean expressions
      example"
    languageId: markdown
  - kind: 2
    value: |
      SELECT
           order_id,
           customer_id,
           status,
           salesman_id,
           order_date
      FROM
         orders
      WHERE
      (
         status = 'Canceled' 
         OR status = 'Pending'
         )
      AND customer_id = 44
      ORDER BY
          order_date;
    languageId: oracle-sql
  - kind: 1
    value: "#   Using Oracle OR operator to combine with AND operator"
    languageId: markdown
  - kind: 2
    value: expression [NOT] IN (vl,v2,...)
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
           order_id,
           customer_id
      status,
           salesman_id
      Form
         orders
      WHERE
         salesman_id IN (54, 55, 56)
      ORDER BY
           order_id;
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
           order_id,
           customer_id,
           status,
           salesman_id
      FROM
         orders
      WHERE
         status IN ('Pending', 'Canceled')
      ORDER BY
      order_id;
    languageId: oracle-sql
  - kind: 1
    value: "#   Oracle IN"
    languageId: markdown
  - kind: 2
    value: |
      SELECT
           order_id,
           customer_id,
           status ,
           salesman_id
      FROM
         orders
      WHERE
          status NOT IN ('Shipped', 'Canceled')
      ORDER BY
      order_id;
    languageId: oracle-sql
  - kind: 1
    value: "#   Oracle NOT IN"
    languageId: markdown
  - kind: 2
    value: |
      SELECT
          employee_id ,
          first_name,
          last_name
      FROM
         employees
      WHERE
         employee_id IN(
            SELECT
               DISTINCT salesman_id
      FROM
         orders
      WHERE
         status = 'Canceled');
      ORDER BY
         first_Name;
    languageId: oracle-sql
  - kind: 1
    value: "#   Oracle IN subquery "
    languageId: markdown
  - kind: 2
    value: |
      SELECT
          DISTINCT salesman_id
      FROM
         orders
      WHERE
         status = 'Canceled'
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
          customer_id,
          name
      FROM
          customers
      WHERE
          customer_id NOT IN(
      SELECT
          customer_id
      From
      orders);
    languageId: oracle-sql
  - kind: 1
    value: "#  Oracle NOT IN subquery "
    languageId: markdown
  - kind: 2
    value: |
      SELECT
          custcner_id,
      status,
          salesman_id
      FROM
         orders
      WHERE
         salesman_id IN( 60,
      61,
      62)
      ORDER BY
          customer_id;
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
           customer_id,
           status,
           salesman_id
      FROM
         orders
      WHERE
         salesman_id = 60
         OR salesman_id = 61
         OR salesman_id = 62
      ORDER BY
      customer_id;
    languageId: oracle-sql
  - kind: 1
    value: "#    Oracle IN vs. OR"
    languageId: markdown
  - kind: 2
    value: salesman_id NOT IN (60,61,62);
    languageId: oracle-sql
  - kind: 2
    value: |
      salesman_id != 60
      AND salesman_id != 61
      AND salesman_id != 62;
    languageId: oracle-sql
  - kind: 2
    value: expression [ NOT ] BETWEEN low AND high
    languageId: oracle-sql
  - kind: 2
    value: value >= low AND value <= high
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
           product_name,
           standard_cost
      FROM
          products
      WHERE
         standard_cost BETWEEN 500 AND 600
      ORDER BY
         standard_cost ;
    languageId: oracle-sql
  - kind: 1
    value: "#   Oracle BETWEEN numeric values"
    languageId: markdown
  - kind: 2
    value: |
      SELECT
          product_name,
          standard_cost
      FROM
         products
      WHERE
         standard_cost NOT BETWEEN 500 AND 600
      ORDER BY
         product_name;
    languageId: oracle-sql
  - kind: 1
    value: "#    Oracle BETWEEN numeric values"
    languageId: markdown
  - kind: 2
    value: |
      SELECT
          order_id,
          customer_id,
          status,
          order_date
      FROM
         orders
      WHERE
         order_date BETWEEN DATE '2016-12-01' AND DATE '2016-12-31'
      ORDER BY
         order_date ;
    languageId: oracle-sql
  - kind: 1
    value: "#  Oracle BETWEEN dates"
    languageId: markdown
  - kind: 2
    value: expresion [NOT] LIKE pattern [ ESCAPE escape_characters]
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
          first_name,
          last_name,
          phone
      FROM
         contacts
      WHERE
         last_name LIKE 'St%'
      ORDER BY
         last_name;
    languageId: oracle-sql
  - kind: 1
    value: "#   % wildcard character "
    languageId: markdown
  - kind: 2
    value: |
      SELECT
          first_name,
          last_name,
          phone
      FROM
          contacts
      WHERE
          last_name LIKE '%er'
      ORDER BY
          last_name;
    languageId: oracle-sql
  - kind: 1
    value: "#  % wildcard character "
    languageId: markdown
  - kind: 2
    value: "%er"
    languageId: oracle-sql
  - kind: 2
    value: |
      UPPER( last_name ) LIKE 'ST%'

      LOWER(last_name LIKE 'st%'
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
          first_name,
          last_name,
          email
      FROM
         contacts
      WHERE
         UPPER( first_name ) LIKE 'CH%';
      ORDER BY
        first_name;
    languageId: oracle-sql
  - kind: 1
    value: "#  % wildcard character "
    languageId: markdown
  - kind: 2
    value: |
      SELECT
          first_name, last_name, phone
      FROM
         contacts
      WHERE
         phone NOT LIKE '+1%'
      ORDER BY
        first_name;
    languageId: oracle-sql
  - kind: 1
    value: "#  % wildcard character "
    languageId: markdown
  - kind: 2
    value: |
      SELECT
         first_name,
         last_name,
         email,
         phone
      FROM
         contacts
      WHERE
         first_name  LIKE 'Je_i'
      ORDER BY
         first_name;
    languageId: oracle-sql
  - kind: 1
    value: "#  _ wildcard character"
    languageId: markdown
  - kind: 2
    value: |
      SELECT
          first_name,
          last_name,
          email,
          phone
      FROM
         contacts
      WHERE
         first_name LIKE 'Je_%';
    languageId: oracle-sql
  - kind: 2
    value: LIKE '%25!%% 'ESCAPE '!'
    languageId: oracle-sql
  - kind: 2
    value: |
      CREATE TABLE discounts
      (
           product_id NUMBER,
           discount_message VARCHAR2(255) NOT NULL,
           PRIMARY KEY( product_id ));

      INSERT INTO discounts (product_id, discount_message)
      VALUES(1,
            'Buy 1 and Get 2S% OFF on 2nd ');
      INSERT INTO discounts (product_id, discount_message)
      VALUES(2,
            'Buy 2 and Get 50% OFF on 3rd ');
      INSERT INTO discounts(product_id, discount_massage)
      VALUES(3,
            'Buy 3 Get 1 free');
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
           product_id ,
           discounts_message
      FROM
           discounts
      WHERE
           discount_message LIKE '%25!%%' ESCAPE '!';
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT * FROM orders
      WHERE salesman_id = NULL
      ORDER BY order_date DESC;
    languageId: oracle-sql
  - kind: 2
    value: expression | column IS NOT NULL
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT * FROM orders
      WHERE salesman_id IS NOT NULL
      ORDER BY order_date DESC;
    languageId: oracle-sql
