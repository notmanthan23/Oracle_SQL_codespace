cells:
  - kind: 2
    value: |
      SELECT
      CHR( 83 ) ,
      CHR( 115 )
      FROM
      dual;
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
      CHR( NULL )
      FROM
      DUAL;
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
      first_name || ' ' || last_name ||
      CHR (9) || ' joined on ' || CHR(9) ||
      to_char(hire_date,'DD-MON-YYYY') first_5_employess
      FROM
      employees
      ORDER BY
      hire_date
      FETCH
      FIRST 5 ROWS ONLY;
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
      CONCAT( 'Happy' , 'coding' )
      FROM
      dual ;
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
      CONCAT( CONCAT('Happy', 'coding'), 'together')
      FROM
      dual;
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
      'Happy' || 'coding' || 'together'
      FROM
      dual;
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
      first_name || ' ' || last_name
      FROM
      employees;
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
      CONCAT('let', 's', 'try this' )
      FROM
      dual;
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
      INSTR('This iS a playlist ', 'is' ) substring_location
      FROM
      dual;
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
      INSTR ('This is a playlist', 'is', 1,2) second_occurrence,
      INSTR('This is a playlist', 'is', 1,3) third_occurrence
      FROM
      dual;
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
      INSTR('This is a playlist', 'are') substring_location
      FROM
      dual;
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
      INSTR ('This is a playlist ' , 'is', -1 ) substring_location
      FROM
      dual;
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
      INITCAP( 'hi john' )
      FROM
      DUAL;
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
      INITCAP( first_name || ' ' || last_name ) full_name
      FROM
      contacts
      ORDER BY
      full_name;
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
      'oracle LENGTH ' string,
      LENGTH( 'oracle LENGTH') Len
      FROM
      dual ;
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
      first_name,
      LENGTH(first_name)
      FROM
      employees
      ORDER BY
      LENGTH(first_name) DESC;
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
      LENGTH( first_name ) len,
      COUNT(*)
      FROM
      employees
      GROUP BY
      LENGTH( first_name )
      ORDER BY Len;
    languageId: oracle-sql
  - kind: 2
    value: >
      SELECT

      product_name,

      CASE

      WHEN LENGTH( description )> 50 THEN CONCAT( SUBSTR( description, 1,50),
      '...' )

      ELSE description

      END product_excerpt

      FROM

      products

      ORDER BY

      product_name ;
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
      LTRIM('XYZ')
      FROM
      dual;
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
      LTRIM('123456XYZ', '123')
      FROM
      dual;
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
      product_name
      FROM
      products
      WHERE
      product_name LIKE 'ASRock%'
      ORDER BY
      product_name;
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
      product_name,
      LTRIM( product_name, 'ASRock') short_product_name
      FROM
      products
      WHERE
      product_name LIKE 'ASRock%'
      ORDER BY
      product_name;
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
      REPLACE ('This is a test', 'is', 'IS')
      FROM
      dual;
    languageId: oracle-sql
  - kind: 2
    value: |
      CREATE TABLE article (
      article_id NUMBER GENERATED BY DEFAULT AS IDENTITY,
      title VARCHAR2( 255 ) ,
      article_body VARCHAR2(4000) ,
      PRIMARY KEY (article_id)
      );
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
      article_id, title, article_body
      FROM
      articles;
    languageId: oracle-sql
  - kind: 2
    value: |
      UPDATE
      articles
      SET
      article-body= REPLACE(article_body, '<strong', '<b>');
      UPDATE
      articles
      SET
      article_body = REPLACE(article_body, '</stronge>', '</b>');
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
      article_id, title, article_body
      FROM
      articles;
    languageId: oracle-sql
