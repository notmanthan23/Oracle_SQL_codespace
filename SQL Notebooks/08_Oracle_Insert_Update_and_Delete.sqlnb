  - kind: 2
    value: |
      CREATE TABLE discounts (
      discount_id NUMBER GENERATED BY DEFAULT AS IDENTITY,
      discount_name VARCHAR2(25S) NULL,
      amount NUMBER(3,1) NOT NULL,
      start_date DATE NOT NULL,
      expired_date DATE NOT NULL);
    languageId: oracle-sql
  - kind: 2
    value: |
      INSLRI INIO discount(discount_name,amount,start_date, expired_date)
      VALUES('Summer Promotaion',9.5,DATE '2017-05-01,'DATE '2017-08-31');
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
      *
      FROM
      discounts;
    languageId: oracle-sql
  - kind: 2
    value: |
      INSERT INTO discounts(discount_name,amount,start_date,expired_date)
      VALUSE('Winter Promotaion 2017', 10.5,CURRENT_DATE,DATE '2017-12-31');
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
      *
