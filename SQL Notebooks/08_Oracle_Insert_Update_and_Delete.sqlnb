      discounts;
    languageId: oracle-sql
  - kind: 2
    value: |
      INSERT INTO target_table (coil,col2,col3)
      SELECT col1,
      col2,
      col3,
      FROM source_table
      WHERE condition;
    languageId: oracle-sql
  - kind: 2
    value: |
      CREATE TABLE sales (
      customer_id NUMBER,
      product_id NUMBER,
      order_date DATE NOT NULL,
      total NUMBER(9,2) DEFAULT O NOT NULL,
      PRIMARY KEY(customer_id,
      product_id,
      order_date )
      );
    languageId: oracle-sql
  - kind: 2
    value: |
      INSERT INTO sales(customer_id, product_id, order_date,total)
      SELECT customer_id,
      product_id,
      order_date,
      SUM(quantity * unit_price) amount
      FROM orders
      INNER JOIN order_items USING(order_id)
      WHERE status = 'Shipped'
      GROUP BY customer_id,
      product_id,
      order_date;
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT *
      FROM sales
      ORDER BY order_date DESC,
      total DESC;
    languageId: oracle-sql
  - kind: 2
    value: |
      CREATE TABLE sales_2017
      AS SELECT
      *
      FROM
      sales
      WHERE
      1 = 0;
    languageId: oracle-sql
  - kind: 2
    value: |
      INSERT INTO sales_2017
      SELECT customer_id,
      product_id ,
      order_date,
      SUM(quantity * unit_price) amount
      FROM orders
      INNER JOIN order_items USING(order_id)
      WHERE status = 'Shipped' AND EXTRACT(year from order_date) = 2017
      GROUP BY customer_id,
      product_id,
      order_date;
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT *
      FROM sales_2017
      ORDER BY order_date DESC,
      total DESC;
    languageId: oracle-sql
  - kind: 2
    value: |
      CREATE TABLE customer_list(
      list_id NUMBER GENERATED BY DEFAULT AS IDENTITY,
      first_name varchar2(255) NOT NULL,
      last_name varchar2(255) NOT NULL,
      email varchar2(255) NOT NULL,
      sent NUMBER (1) NOT NULL,
      sent_date DATE,
      PRIMARY KEY(list_id)
      );
    languageId: oracle-sql
  - kind: 2
    value: |
      INSERT INTO
      customer_list(
      first_name,
      last_name,
      enail,
      sent
      ) SELECT
      first_name,
      last_name,
      email,
      0
      FROM
      contacts;
    languageId: oracle-sql
  - kind: 2
