  - kind: 2
    value: |
      CREATE TABLE parts (
      part_id NUMBER GENERATED BY DEFAULT AS IDENTITY,
      part_name VARCHAR(50) NOT NULL,
      lead_time NUMBER(2,0) NOT NULL,
      cost NUMBER(9,2) NOT NULL,
      status NUMBER(1,0) NOT NULL,
      PRIMARY KEY (part_id)
      );
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
      *
      FROM
      parts
      ORDER BY
      part_name;
    languageId: oracle-sql
  - kind: 2
    value: |
      UPDATE
      parts
      SET
      cost =130
      WHERE
      part_id = 1;
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
      *
      FROM
      parts
      WHERE
      part_id = 1;
    languageId: oracle-sql
  - kind: 2
    value: |
      UPDATE
      parts
      SET
      lead_time = 30,
      cost = 120,
      status = 1
      WHERE
      part_id = 5;
    languageId: oracle-sql
  - kind: 2
    value: |
      UPDATE
      parts
      SET
      cost = cost* 1.05;
    languageId: oracle-sql
  - kind: 2
    value: |
