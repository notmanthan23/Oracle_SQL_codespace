  - kind: 2
    value: |
      DELETE
      FROM
      orders
      WHERE
      order_id = 1;
      DELETE
      FROM
      order_items
      WHERE
      order_id = 1;
      COMMIT WORK;
    languageId: oracle-sql
  - kind: 2
    value: |
      CREATE TABLE order_items
      (
      order_id  NUMBER(12,)
      -- other columns
      -- ...
      CONSTRAINT fk_order_items_orders
      FOREIGN KEY( order_id )
      REFERENCES orders( order_id )
      ON DELETE CASCADE
      );
    languageId: oracle-sql
  - kind: 2
    value: |
      DELETE
      FROM
      orders
      WHERE
      order_id = 1;
    languageId: oracle-sql
