  - kind: 2
    value: |
      CREATE TABLE sales AS
      SELECT
      order_id,
      item_id,
      product_id,
      quantity,
      unit_price,
      status,
      order_date,
      salesman_id
      FROM
      orders
      INNER JOIN order_items
      USING (order_id);
    languageId: oracle-sql
  - kind: 2
    value: |
      DELETE
      FROM
      sales
      WHERE
      order_id = 1
      AND item_id =1;
    languageId: oracle-sql
  - kind: 2
