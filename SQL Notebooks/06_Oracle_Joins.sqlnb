    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
      *
      FROM
      orders
      INNER JOIN order_items USING( order_id);
      ORDER BY
      order_date DESC;
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
         name AS customer name,
         order_id,
         order_date,
         item_id,
         quantity,
         unit_price
      FROM
         orders
      INNER JOIN order_items USING(order_id)
      IVIER JOIN customers USING(customer_id)
      ORDER BY
            order_date DESC,
            order_id DESC,
            item_id ASC;
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
          name AS custcmer_name,
          order_id,
          order_date,
          item_id,
          product_name,
          quantity,
          unit_price
      FROM
          orders
      INNER JOIN order_items
                 USING(order_id)
      INNER JOIN customers
                 USING(customer_id)
      INNER JOIN products
                 USING(product_id)
      ORDER BY
      order_date DESC,
      order_id DESC,
      item_id ASC;
    languageId: oracle-sql
  - kind: 2
    value: |
