  - kind: 2
    value: |
      SELECT
          name,
          order_id,
          status,
          order_date
      FROM
          customers
      LEFT JOIN orders
                USING(customer_id)
      ORDER BY
            name;
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
           order_id,
           status,
           employee_id,
           last_name
      FROM
          orders
      LEFT JOIN employees ON
           enployee_id = salesman_id
      WHERE
          order_id = 58;
    languageId: oracle-sql
  - kind: 2
    value: |
