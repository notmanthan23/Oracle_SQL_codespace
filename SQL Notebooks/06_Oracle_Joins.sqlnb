  - kind: 2
    value: |
      SELECT
      (e. first_name || ' ' || e.last_name) employee,
      (m. first_name || ' ' || m.last_name) manager,
      e. job_title
      FROM
      employee e
      LEFT JOIN employee m ON
      m.employee_id = e.manager_id
      ORDER BY
      manager;
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
      el. hire_date,
      (el.first_næme || ' ' || el.last_name) employee1,
      (e2.first_name || ' ' || e2.last_name) employee2
      FROM
      employees el
      INNER JOIN employees e2 ON
      e1.employee_id> e2.employee_id
      AND el.hire_date = e2.hire_date
      ORDER BY
      e1.hire_date DESC'
      employee1,
      employee2;
    languageId: oracle-sql
